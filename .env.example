# Copy this file to .env and fill in real values locally.
# .env is git-ignored and must never be committed.

# API key used for outbound calls to third-party services (placeholder only)
API_KEY=replace-with-a-real-api-key

# Token required in the X-Admin-Token header to access /admin (placeholder only)
ADMIN_TOKEN=replace-with-a-strong-random-admin-token

# Path to the SQLite database file
DATABASE_PATH=app.db
